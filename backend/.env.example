# Обязательные
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_HOST=your_dashscope_endpoint.maas.aliyuncs.com
TAVILY_API_KEY=your_tavily_api_key
LLM_MODEL=qwen3.6-flash

# Telegram/MAX боты (если используются)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
MAX_BOT_TOKEN=your_max_bot_token

# JWT (настройки по умолчанию подходят для разработки)
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Микросервисы (значения по умолчанию для Docker Compose)
INTAKE_SERVICE_URL=http://intake-agent:8001
LAWYER_SERVICE_URL=http://lawyer-service:8002

# Auth DB (SQLite по умолчанию)
AUTH_DATABASE_URL=sqlite:///./db/auth.db

# Логирование
LOG_LEVEL=INFO
