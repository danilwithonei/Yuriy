FROM python:3.12-slim

WORKDIR /app

# Установка системных зависимостей для сборки, если нужны (например, для некоторых библиотек)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Копируем requirements и устанавливаем их
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем исходный код и тесты
COPY . .

# Команда по умолчанию - запуск pytest с покрытием
CMD ["pytest", "--cov=.", "--cov-report=term-missing", "tests/"]
